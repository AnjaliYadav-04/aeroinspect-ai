# SQLite (local dev - no Postgres needed!)
DATABASE_URL=sqlite+aiosqlite:///./backend/data/drone_inspection.db

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-super-secret-key-here-min-32-chars

# AI Engine
MODEL_PATH=./ai-engine/models/yolov8n-drone.pt
CONFIDENCE_THRESHOLD=0.25
DEVICE=cpu

# Mapbox (Frontend)
VITE_MAPBOX_TOKEN=your-mapbox-token
VITE_API_URL=http://localhost:8000/api/v1
